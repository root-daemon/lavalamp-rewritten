<column background="background">
  <row grow="1">
    <panel width="252" padding="0">
      <column grow="1">
        <row height="56" padding="14" gap="10" cross="center" window-drag="true">
          <icon name="circle-dot" size="sm" />
          <column gap="1" grow="1">
            <text>Lavalamp</text>
            <text foreground="text_muted">{workspaceLabel}</text>
          </column>
        </row>
        <separator />

        <column padding="12" gap="12" grow="1">
          <button icon="plus" variant="primary" on-press="new_chat" label="Start New Task">New Task</button>

          <row height="28" cross="center">
            <text grow="1" foreground="text_muted">Tasks</text>
            <badge variant="secondary">{session_count}</badge>
          </row>

          <scroll grow="1" label="Recent sessions">
            <column gap="3">
              <if test="{hasSessions}">
                <for each="sessionItems" key="key" as="session">
                  <list-item selected="{session.selected}" on-press="select_session:{session.key}" label="Open session">
                    <row gap="8" cross="center" grow="1">
                      <icon name="file-text" size="sm" />
                      <text grow="1" wrap="true">{session.prompt}</text>
                    </row>
                  </list-item>
                </for>
              </if>
              <else>
                <panel padding="10">
                  <text wrap="true" foreground="text_muted">No saved tasks yet.</text>
                </panel>
              </else>
            </column>
          </scroll>
        </column>

        <separator />
        <column padding="14" gap="5">
          <row gap="7" cross="center">
            <icon name="folder" size="sm" />
            <text grow="1" wrap="true">{workspaceLabel}</text>
          </row>
          <text foreground="text_muted">{backendLabel} · {modeLabel}</text>
        </column>
      </column>
    </panel>

    <separator />

    <column grow="1" background="background">
      <row height="56" padding="16" gap="10" cross="center" window-drag="true">
        <column gap="1" grow="1">
          <text>Task</text>
          <text foreground="text_muted">{backendLabel} · {modeLabel} · {modelLabel}</text>
        </column>
        <badge variant="secondary">{connectionLabel}</badge>
        <stack>
          <button icon="panel-right" size="icon" variant="ghost" on-press="toggle_inspector" label="Toggle Inspector"></button>
          <tooltip anchor="below">Toggle Inspector</tooltip>
        </stack>
        <stack>
          <button icon="plus" size="icon" variant="ghost" on-press="new_chat" label="Start New Task"></button>
          <tooltip anchor="below">Start New Task</tooltip>
        </stack>
      </row>
      <separator />

      <scroll grow="1" label="Conversation">
        <column padding="24" gap="20">
          <if test="{hasError}">
            <alert variant="destructive">
              <column gap="8" grow="1">
                <text wrap="true">{errorText}</text>
                <row gap="6">
                  <button size="sm" variant="secondary" on-press="retry_connection">Retry</button>
                  <button size="sm" variant="ghost" on-press="dismiss_error">Dismiss</button>
                </row>
              </column>
            </alert>
          </if>

          <if test="{hasCommandResult}">
            <panel padding="14">
              <column gap="10">
                <row gap="8" cross="center">
                  <icon name="terminal" size="sm" />
                  <text grow="1">{commandTitle}</text>
                  <button icon="x" size="icon" variant="ghost" on-press="dismiss_command" label="Dismiss Result"></button>
                </row>
                <separator />
                <column gap="5">
                  <for each="commandRows" key="id" as="row">
                    <text wrap="true" foreground="text_muted">{row.text}</text>
                  </for>
                </column>
              </column>
            </panel>
          </if>

          <if test="{emptyState}">
            <column gap="18" main="center" cross="center" grow="1">
              <avatar>LL</avatar>
              <column gap="6" cross="center">
                <text>What are we building?</text>
                <text foreground="text_muted">Start with a task or choose a quick launch.</text>
              </column>
              <column width="340" gap="7">
                <list-item on-press="starter_explain" label="Explain codebase">
                  <row gap="10" cross="center" grow="1">
                    <icon name="search" size="sm" />
                    <column gap="2" grow="1">
                      <text>Explore the codebase</text>
                      <text wrap="true" foreground="text_muted">Map architecture and find a starting point.</text>
                    </column>
                  </row>
                </list-item>
                <list-item on-press="starter_tests" label="Run and fix tests">
                  <row gap="10" cross="center" grow="1">
                    <icon name="check-circle" size="sm" />
                    <column gap="2" grow="1">
                      <text>Run and fix tests</text>
                      <text wrap="true" foreground="text_muted">Verify the project and repair failures.</text>
                    </column>
                  </row>
                </list-item>
                <list-item on-press="starter_review" label="Review current changes">
                  <row gap="10" cross="center" grow="1">
                    <icon name="eye" size="sm" />
                    <column gap="2" grow="1">
                      <text>Review current changes</text>
                      <text wrap="true" foreground="text_muted">Inspect the active diff for regressions.</text>
                    </column>
                  </row>
                </list-item>
              </column>
              <row gap="6">
                <badge variant="secondary">{backendLabel}</badge>
                <badge variant="secondary">{modeLabel}</badge>
                <badge variant="secondary">{connectionLabel}</badge>
              </row>
            </column>
          </if>

          <for each="messageItems" key="id" as="message">
            <if test="{message.isUser}">
              <row main="end">
                <bubble variant="primary" width="560" padding="12">
                  <text wrap="true">{message.content}</text>
                </bubble>
              </row>
            </if>
            <else>
              <row gap="10" cross="start">
                <avatar size="sm">LL</avatar>
                <column gap="7" grow="1">
                  <text foreground="text_muted">Lavalamp</text>
                  <markdown source="{message.content}" />
                </column>
              </row>
            </else>
          </for>

          <if test="{hasAssistantText}">
            <row gap="10" cross="start">
              <avatar size="sm">LL</avatar>
              <column gap="7" grow="1">
                <row gap="7" cross="center">
                  <text foreground="text_muted">Lavalamp</text>
                  <spinner size="sm" />
                </row>
                <markdown source="{assistantText}" />
              </column>
            </row>
          </if>
          <else>
            <if test="{processing}">
              <row gap="8" cross="center">
                <spinner size="sm" />
                <text foreground="text_muted">Working…</text>
              </row>
            </if>
          </else>

          <if test="{hasThinking}">
            <accordion text="Reasoning">
              <text wrap="true" foreground="text_muted">{thinkingText}</text>
            </accordion>
          </if>

          <if test="{permission_pending}">
            <panel padding="14">
              <column gap="12">
                <row gap="8" cross="center">
                  <icon name="alert" size="sm" />
                  <column gap="2" grow="1">
                    <text>Permission Required</text>
                    <text foreground="text_muted">{permissionTool} wants to modify workspace.</text>
                  </column>
                </row>
                <button-group gap="4">
                  <button variant="primary" on-press="allow_permission">Allow Once</button>
                  <button variant="secondary" on-press="always_allow_permission">Always Allow</button>
                  <button variant="ghost" on-press="deny_permission">Deny</button>
                </button-group>
              </column>
            </panel>
          </if>

          <if test="{questionPending}">
            <panel padding="16">
              <column gap="12">
                <row gap="8" cross="center">
                  <icon name="info" size="sm" />
                  <column gap="2" grow="1">
                    <text>Input requested</text>
                    <text foreground="text_muted">{questionProgressLabel}</text>
                  </column>
                </row>
                <text wrap="true">{currentQuestionText}</text>
                <if test="{questionIsInput}">
                  <input text="{questionAnswerText}" placeholder="Type your answer" on-input="question_edit" label="Question answer" />
                </if>
                <if test="{questionIsChoice}">
                  <column gap="4">
                    <for each="questionOptionItems" key="key" as="option">
                      <list-item selected="{option.selected}" on-press="question_option:{option.key}" label="Choose answer">
                        <text grow="1">{option.label}</text>
                      </list-item>
                    </for>
                  </column>
                </if>
                <if test="{hasQuestionError}">
                  <alert variant="destructive"><text wrap="true">{questionErrorText}</text></alert>
                </if>
                <row gap="6" main="end">
                  <if test="{questionHasPrevious}">
                    <button variant="ghost" on-press="question_back">Back</button>
                  </if>
                  <button variant="primary" on-press="question_next">{questionActionLabel}</button>
                </row>
              </column>
            </panel>
          </if>
        </column>
      </scroll>

      <column padding="16" gap="8">
        <input-group label="Message Composer" height="124">
          <textarea text="{draftText}" placeholder="Describe the task…" on-input="draft_edit" on-submit="send" label="Message" />
          <input-group-actions gap="6">
            <badge variant="secondary">{backendLabel}</badge>
            <badge variant="secondary">{modeLabel}</badge>
            <stack>
              <button icon="plus" variant="ghost" size="icon" on-press="command_paste_image" label="Attach Clipboard Image"></button>
              <tooltip anchor="above">Attach clipboard image</tooltip>
            </stack>
            <spacer grow="1" />
            <if test="{processing}">
              <button icon="plus" variant="primary" size="sm" disabled="{queueDisabled}" on-press="queue_prompt" label="Queue Follow-up">Queue</button>
              <button icon="x" variant="secondary" size="sm" on-press="cancel" label="Stop Current Turn">Stop</button>
            </if>
            <else>
              <button icon="send" variant="primary" size="sm" disabled="{sendDisabled}" on-press="send" label="Send Message">Send</button>
            </else>
          </input-group-actions>
        </input-group>
        <text foreground="text_muted">{modelLabel} · {usageLabel}</text>
      </column>
    </column>

    <if test="{inspectorVisible}"><separator /></if>

    <if test="{inspectorVisible}"><panel width="276" padding="0">
      <column grow="1">
        <row height="56" padding="16" cross="center" window-drag="true">
          <text grow="1">Inspector</text>
          <badge variant="secondary">{tool_count}</badge>
        </row>
        <separator />

        <scroll grow="1" label="Run activity">
          <column padding="16" gap="18">
            <column gap="8">
              <text foreground="text_muted">Mode</text>
              <button-group gap="4">
                <if test="{modeIsBuild}"><button size="sm" variant="primary" on-press="mode_build">Build</button></if><else><button size="sm" variant="ghost" on-press="mode_build">Build</button></else>
                <if test="{modeIsAsk}"><button size="sm" variant="primary" on-press="mode_ask">Ask</button></if><else><button size="sm" variant="ghost" on-press="mode_ask">Ask</button></else>
                <if test="{modeIsPlan}"><button size="sm" variant="primary" on-press="mode_plan">Plan</button></if><else><button size="sm" variant="ghost" on-press="mode_plan">Plan</button></else>
              </button-group>
            </column>

            <column gap="8">
              <text foreground="text_muted">Provider</text>
              <button-group gap="4">
                <if test="{backendIsFlue}"><button size="sm" variant="primary" on-press="backend_flue">Flue</button></if><else><button size="sm" variant="ghost" on-press="backend_flue">Flue</button></else>
                <if test="{backendIsCodex}"><button size="sm" variant="primary" on-press="backend_codex">Codex</button></if><else><button size="sm" variant="ghost" on-press="backend_codex">Codex</button></else>
              </button-group>
            </column>

            <if test="{hasModels}">
              <column gap="8">
                <text foreground="text_muted">Model</text>
                <column gap="3">
                  <for each="modelChoiceItems" key="key" as="choice">
                    <list-item selected="{choice.selected}" on-press="select_model:{choice.key}" label="Select model">
                      <text grow="1" wrap="true">{choice.name}</text>
                    </list-item>
                  </for>
                </column>
              </column>
            </if>

            <column gap="8">
              <text foreground="text_muted">Workspace</text>
              <row gap="6">
                <button grow="1" size="sm" variant="ghost" on-press="command_sessions">Sessions</button>
                <button grow="1" size="sm" variant="ghost" on-press="command_workspace">Details</button>
              </row>
              <row gap="6">
                <button grow="1" size="sm" variant="ghost" on-press="command_permissions">Permissions</button>
                <button grow="1" size="sm" variant="ghost" on-press="command_tools">Tools</button>
              </row>
              <row gap="6">
                <button grow="1" size="sm" variant="ghost" on-press="command_analytics">Analytics</button>
                <button grow="1" size="sm" variant="ghost" on-press="command_benchmarks">Benchmarks</button>
              </row>
            </column>

            <column gap="8">
              <text foreground="text_muted">Insights</text>
              <row gap="6">
                <button grow="1" size="sm" variant="ghost" on-press="command_usage">Usage</button>
                <button grow="1" size="sm" variant="ghost" on-press="command_memory">Memory</button>
              </row>
              <row gap="6">
                <button grow="1" size="sm" variant="ghost" on-press="command_skills">Skills</button>
                <button grow="1" size="sm" variant="ghost" on-press="command_mcp">MCP</button>
              </row>
              <button-group gap="4">
                <button size="sm" variant="ghost" on-press="command_compact">Compact</button>
                <button size="sm" variant="ghost" on-press="command_undo">Undo</button>
                <button size="sm" variant="ghost" on-press="command_copy">Copy</button>
              </button-group>
            </column>

            <separator />

            <column gap="7">
              <text foreground="text_muted">Current Run</text>
              <row gap="8" cross="center">
                <icon name="circle-dot" size="sm" />
                <column gap="2" grow="1">
                  <text>{modelLabel}</text>
                  <text foreground="text_muted">{providerLabel} · {modeLabel}</text>
                </column>
              </row>
            </column>

            <separator />

            <column gap="8">
              <text foreground="text_muted">Activity</text>
              <if test="{hasTools}">
                <timeline gap="7" label="Tool activity timeline">
                  <for each="toolItems" key="id" as="tool">
                    <timeline-item title="{tool.name}" description="{tool.summary}" meta="{tool.status}" />
                  </for>
                </timeline>
              </if>
              <else>
                <text wrap="true" foreground="text_muted">No activity yet.</text>
              </else>
            </column>

            <if test="{hasTerminal}">
              <separator />
              <accordion text="Terminal Output">
                <text wrap="true">{terminalText}</text>
              </accordion>
            </if>
          </column>
        </scroll>
      </column>
    </panel></if>
  </row>

  <separator />
  <status-bar>{connectionLabel} · {usageLabel}</status-bar>
</column>
